{
  "name": "@net-zero/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "test:concurrency": "vitest run test/concurrency",
    "test:retention": "vitest run test/retention",
    "test:demo-separation": "vitest run test/demo-separation",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed-demo": "tsx src/database/seed.ts",
    "db:reset-demo": "tsx src/database/reset-demo.ts",
    "db:demo-readiness": "tsx src/database/demo-readiness.ts",
    "db:production-readiness": "tsx src/database/production-readiness.ts",
    "db:test-from-empty": "vitest run test/database"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.876.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@net-zero/contracts": "workspace:*",
    "@net-zero/domain": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.5",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "testcontainers": "^11.5.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
